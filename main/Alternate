// RPI_ILI9486_DRIVER is for the Raspberry Pi style boards with the special 16-bit SPI wiring.
#define RPI_ILI9486_DRIVER

// Screen size in pixels (portrait orientation, before rotation)
#define TFT_WIDTH  320
#define TFT_HEIGHT 480

// ---------------- Pins (Teensy 4.0 pin numbers) ----------------
#define TFT_MISO 12   // display header pin 21 
#define TFT_MOSI 11   // display header pin 19
#define TFT_SCLK 13   // display header pin 23
#define TFT_CS   10   // display header pin 24 (LCD chip select)
#define TFT_DC    9   // display header pin 18 (data/command)
#define TFT_RST   8   // display header pin 22 (reset)
#define TOUCH_CS  7   // display header pin 26 (touch chip select)

// ---------------- Fonts (the library needs at least these) ----------------
#define LOAD_GLCD   // Basic small font
#define LOAD_FONT2  // Small font
#define LOAD_FONT4  // Medium font
#define LOAD_FONT6  // Large number font
#define LOAD_FONT7  // 7-segment style font
#define LOAD_FONT8  // Very large number font
#define LOAD_GFXFF  // FreeFonts
#define SMOOTH_FONT

// ---------------- SPI speeds ----------------
#define SPI_FREQUENCY       16000000  // Start slow (16 MHz). Raise it once everything works.
#define SPI_TOUCH_FREQUENCY  2500000  // Touch chip needs a slow clock

#include <TFT_eSPI.h>   // The library you installed

// Create the display object. It reads the pins from User_Setup.h
TFT_eSPI tft = TFT_eSPI();

// How long to show each color, in milliseconds
const int COLOR_DELAY_MS = 1000;

void setup() {
  Serial.begin(115200);

  tft.init();          // Starts the display (resets it, sends the setup commands)
  tft.setRotation(1);  // 1 = landscape, 480 wide by 320 tall
}

void loop() {
  // Fill the whole screen with one color, wait, then change.
  // If the colors on the screen don't match the names, see the notes below.
  tft.fillScreen(TFT_RED);
  Serial.println("Showing red");
  delay(COLOR_DELAY_MS);

  tft.fillScreen(TFT_GREEN);
  Serial.println("Showing green");
  delay(COLOR_DELAY_MS);

  tft.fillScreen(TFT_BLUE);
  Serial.println("Showing blue");
  delay(COLOR_DELAY_MS);
}
